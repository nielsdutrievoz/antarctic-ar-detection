[
 {
  "id": "2018-12-concordia",
  "start": "2018-12-16",
  "end": "2018-12-24",
  "title": {
   "fr": "Décembre 2018",
   "en": "December 2018"
  },
  "description": {
   "fr": "Rivière atmosphérique d'origine atlantique, arrivée sur la Terre de Coats (ouest de la Terre de la Reine-Maud) le 17 décembre, puis traversée du plateau jusqu'à Concordia du 19 au 23 décembre. Le 21 décembre, la température à Concordia a atteint −14,7 °C, la deuxième plus élevée depuis 2005. Sur ces cartes, l'algorithme détecte l'AR à son arrivée sur la Terre de Coats (17–19 décembre) ; sa progression sur le plateau, où l'IVT reste faible en valeur absolue, ne remplit plus le critère des 20° de latitude et n'est donc pas contourée.",
   "en": "Atlantic-sourced atmospheric river that made landfall over Coats Land (western Dronning Maud Land) on 17 December, then crossed the plateau to Concordia from 19 to 23 December. On 21 December the temperature at Concordia reached −14.7 °C, the second highest since 2005. On these maps the algorithm detects the AR at landfall over Coats Land (17–19 December); its progression over the plateau, where IVT remains low in absolute terms, no longer meets the 20°-latitude criterion and is therefore not contoured."
  },
  "reference": {
   "text": "Dutrievoz et al. (2026), The Cryosphere 20, 1025–1046",
   "url": "https://doi.org/10.5194/tc-20-1025-2026"
  },
